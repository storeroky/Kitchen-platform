# اختر مزوّد توليد الصور:
#   pollinations = مجاني بالكامل، بدون مفتاح API وبدون بطاقة دفع (الافتراضي)
#   openai       = مدفوع، يدعم "تحويل صورة SketchUp" أيضاً
#   stability    = مدفوع، يدعم "تحويل صورة SketchUp" أيضاً
AI_IMAGE_PROVIDER=pollinations

# لا حاجة لأي مفتاح إذا كان المزوّد pollinations — اترك ما يلي فارغاً
# مفتاح OpenAI (فقط إذا اخترت openai) — احصل عليه من https://platform.openai.com/api-keys
OPENAI_API_KEY=

# مفتاح Stability AI (فقط إذا اخترت stability) — احصل عليه من https://platform.stability.ai
STABILITY_API_KEY=

PORT=5174
